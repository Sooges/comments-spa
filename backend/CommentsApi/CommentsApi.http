@CommentsApi_HostAddress = http://localhost:5154

### Get the first page of comments (newest first)
GET {{CommentsApi_HostAddress}}/api/comments
Accept: application/json

### Sort by user name, ascending, second page
GET {{CommentsApi_HostAddress}}/api/comments?sortBy=userName&sortOrder=asc&page=2
Accept: application/json

### Get a captcha: "id" and the picture ("image" is a data URI, open it in a browser to see the code)
GET {{CommentsApi_HostAddress}}/api/captcha
Accept: application/json

### Preview the text (nothing is saved), allowed tags: a, code, i, strong
POST {{CommentsApi_HostAddress}}/api/comments/preview
Content-Type: application/json

{
  "text": "Hello <strong>world</strong> <a href=\"https://example.com\" title=\"Site\">link</a>"
}

### Add a top-level comment, the data is sent as a form
### (use the id of a fresh captcha and the code from its picture)
POST {{CommentsApi_HostAddress}}/api/comments
Content-Type: multipart/form-data; boundary=WebKitFormBoundary

--WebKitFormBoundary
Content-Disposition: form-data; name="userName"

john
--WebKitFormBoundary
Content-Disposition: form-data; name="email"

john@example.com
--WebKitFormBoundary
Content-Disposition: form-data; name="homePage"

https://example.com
--WebKitFormBoundary
Content-Disposition: form-data; name="text"

First comment
--WebKitFormBoundary
Content-Disposition: form-data; name="captchaId"

<captcha id>
--WebKitFormBoundary
Content-Disposition: form-data; name="captchaCode"

<code from the picture>
--WebKitFormBoundary--

### Reply to the comment with id 1 and attach a picture (JPG, GIF, PNG) or a text file (TXT)
POST {{CommentsApi_HostAddress}}/api/comments
Content-Type: multipart/form-data; boundary=WebKitFormBoundary

--WebKitFormBoundary
Content-Disposition: form-data; name="userName"

mary
--WebKitFormBoundary
Content-Disposition: form-data; name="email"

mary@example.com
--WebKitFormBoundary
Content-Disposition: form-data; name="text"

A reply with a picture
--WebKitFormBoundary
Content-Disposition: form-data; name="parentId"

1
--WebKitFormBoundary
Content-Disposition: form-data; name="captchaId"

<captcha id>
--WebKitFormBoundary
Content-Disposition: form-data; name="captchaCode"

<code from the picture>
--WebKitFormBoundary
Content-Disposition: form-data; name="file"; filename="photo.jpg"
Content-Type: image/jpeg

< ./photo.jpg
--WebKitFormBoundary--

### Get an attachment by its id (from the "attachment" field of a comment)
GET {{CommentsApi_HostAddress}}/api/attachments/1
